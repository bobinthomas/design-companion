# Server-side fallback for local dev only. Most people should instead use the
# in-app Settings screen (bring your own Anthropic/Groq/OpenRouter key, stored
# in the browser) — a saved Settings key always takes precedence over this.
# Without either one set, the decision engine still runs for real; only the
# LLM steps (intent extraction, generation, heuristic evaluation) fall back
# to canned demo data.

ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5
