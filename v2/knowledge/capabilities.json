[
  { "id": "primary-action", "name": "Primary action", "category": "actions", "description": "The single most important action in a view", "acceptanceCriteria": ["visually dominant variant", "keyboard activatable", "disabled and loading states"], "requiredStates": ["default", "hover", "focus", "disabled", "loading"], "accessibility": ["visible focus indicator", "accessible name"] },
